# Memoria Central YOOHOO — variables de entorno
# Copia este archivo a .env y rellena MEMORIA_TOKEN.
# El .env real DEBE tener permisos 600 y NUNCA se versiona.

# Token compartido (REST + MCP). Generar con: openssl rand -hex 32
MEMORIA_TOKEN=

# Ruta de la BD (opcional; default: data/memoria.db junto a la app)
# MEMORIA_DB_PATH=/opt/memoria_central/data/memoria.db

# Host/puerto de uvicorn (solo loopback; el proxy hace HTTPS)
MEMORIA_HOST=127.0.0.1
MEMORIA_PORT=8742

# Hook incremental: minutos de throttle entre avances (default 60)
MEMORIA_INTERVALO_MIN=60

# URL base de la API a la que el hook hace POST (local al VPS)
MEMORIA_API_URL=http://127.0.0.1:8742
