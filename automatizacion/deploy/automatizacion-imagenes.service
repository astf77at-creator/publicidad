# Servicio systemd del backend FastAPI de automatización de imágenes.
# Instalar en el VPS como /etc/systemd/system/automatizacion-imagenes.service
#
# Escucha SOLO en 127.0.0.1:8080 (no se expone al exterior). El acceso público
# va por nginx en https://captura.yoohoo.mx/img-api/ (ver nginx-captura-img-api.conf).
#
#   systemctl daemon-reload
#   systemctl enable --now automatizacion-imagenes.service

[Unit]
Description=Automatizacion de imagenes de producto (FastAPI + Odoo + OpenAI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/publicidad/automatizacion
ExecStart=/root/publicidad/automatizacion/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
