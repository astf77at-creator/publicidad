# ============================================================
#  Configuración del backend de automatización de imágenes
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el .env real al repositorio.
# ============================================================

# ---- Odoo (API externa XML-RPC) ----
# Para probar: apunta al Odoo ESPEJO del VPS.
# Para producción: apunta a tu Odoo Online (https://tuempresa.odoo.com).
ODOO_URL=https://tuempresa-espejo.tu-vps.com
ODOO_DB=nombre_de_la_base
ODOO_USERNAME=usuario@correo.com
# API key de Odoo (Ajustes > usuario > Cuenta de seguridad > clave API)
ODOO_API_KEY=

# Mapeo de campos de Odoo (ajústalos a tu instancia).
# Categoría de producto (estándar): categ_id
ODOO_CATEGORY_FIELD=categ_id
# Marca: NO es estándar en Odoo. Pon el nombre real del campo en tu producto.
# Ejemplos comunes: product_brand_id, x_studio_marca, x_marca
ODOO_BRAND_FIELD=product_brand_id
# Referencia interna (estándar): default_code
ODOO_REFERENCE_FIELD=default_code
# Campo del toggle de publicación.
# Con módulo web/eCommerce (website_sale): is_published
# Sin website_sale (p. ej. solo el módulo base 'product'): usa sale_ok (Se puede vender)
ODOO_PUBLISHED_FIELD=is_published

# Nombres de las etiquetas (product.tag)
ODOO_TAG_REVIEW=Revisión de imágenes
ODOO_TAG_READY=Listo

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Cuántas poses generar por producto (5 a 8 según tu prompt)
POSES_POR_PRODUCTO=6

# Cola de trabajos: cuántas generaciones se procesan EN PARALELO (varios
# usuarios a la vez). Cada una consume CPU/RAM y cuota de OpenAI. 2 es seguro.
CONCURRENCIA_JOBS=2

# ---- Salida de imágenes ----
IMG_ANCHO=800
IMG_ALTO=1000
IMG_MAX_KB=100

# ---- Servidor ----
HOST=0.0.0.0
PORT=8080
